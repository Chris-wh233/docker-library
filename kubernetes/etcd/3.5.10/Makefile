REGISTRY?=lcr.loongnix.cn
ORGANIZATION?=kubernetes
REPOSITORY?=etcd
TAG?=3.5.10

IMAGE=$(REGISTRY)/$(ORGANIZATION)/$(REPOSITORY):$(TAG)
SOURCE_URL=https://github.com/loongarch64-releases/etcd/releases/download/v$(TAG)/etcd-v$(TAG)-linux-loongarch64.tar.gz


default: image

src:
	wget -O etcd.tar.gz $(SOURCE_URL)
	tar -xzf etcd.tar.gz
image: src
	docker build \
		-t $(IMAGE) \
		.

push:
	docker push $(IMAGE)
